{
  "manifest_version": 3,
  "name": "推文雷达",
  "version": "0.1.3",
  "description": "为 X/Twitter 信息流按个人目标筛选值得阅读的帖子。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "推文雷达：设置目标" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
